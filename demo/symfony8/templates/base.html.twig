{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell (@NowoUiKit/demo_platform/layout.html.twig).
    This file only declares the demo (nowo_ui_demo_platform). There is one session per firewall, so the user menu
    logs out of the firewall the current page belongs to. -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set _route = app.request.attributes.get('_route')|default('') %}
{% set nowo_ui_demo_platform = {
    bundle: 'Login Throttle',
    home_route: 'demo_home',
    repository: 'https://github.com/nowo-tech/LoginThrottleBundle',
    translation_domain: false,
    auth: {login_route: 'login', logout_route: _route starts with 'admin_' ? 'admin_logout' : 'logout'},
    nav: [
        {label: 'Overview', route: 'demo_home', section: 'Demo'},
        {label: 'Main login', route: 'login', section: 'Firewalls'},
        {label: 'API login', route: 'api_login_page', section: 'Firewalls'},
        {label: 'Admin login', route: 'admin_login', active: ['admin_login', 'admin_home'], section: 'Firewalls'},
    ],
} %}
{% block nowo_ui_document_title %}{% block title %}Login Throttle Demo{% endblock %} — Symfony 8{% endblock %}

{#- A failed sign-in joins the session flashes in the shell's flash region, under the page header. -#}
{% block nowo_ui_flashes %}
    {% set _messages = app.flashes %}
    {% if (error ?? null) %}
        {% set _messages = _messages|merge({error: (_messages.error ?? [])|merge(['Authentication error: ' ~ error.messageKey|trans(error.messageData, 'security')])}) %}
    {% endif %}
    {{ include('@NowoUiKit/demo_platform/_flashes.html.twig', {flash_messages: _messages}) }}
{% endblock %}
