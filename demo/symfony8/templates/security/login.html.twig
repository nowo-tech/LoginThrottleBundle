{% extends 'base.html.twig' %}

{% block title %}Login - Login Throttle Demo{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Login'}) }}
{% endblock %}

{% block body %}
    {{ include('security/_attempt_error.html.twig', {timer_id: 'countdown-timer'}) }}

    <section class="nowo-ui-card">
        <div class="nowo-ui-card__body">
            {{ form_start(login_form) }}
                {{ form_errors(login_form) }}
                {{ form_rest(login_form) }}
            {{ form_end(login_form, {render_rest: false}) }}
        </div>
    </section>

    <div class="nowo-ui-flash nowo-ui-flash--info" role="note">
        <p><strong>Demo credentials for testing</strong></p>
        <ul>
            <li><strong>demo@example.com</strong> / <code>demo123</code> <span class="nowo-ui-badge nowo-ui-badge--success">Regular User</span></li>
            <li><strong>admin@example.com</strong> / <code>admin123</code> <span class="nowo-ui-badge nowo-ui-badge--success">Admin User</span></li>
        </ul>
        <p><strong>Tip:</strong> Try logging in with wrong credentials multiple times (3 attempts) to see login throttling in action! After 3 failed attempts, you'll be blocked for 10 minutes.</p>
    </div>

    {{ include('security/_other_firewalls.html.twig', {links: [
        {path: path('api_login_page'), label: 'API Login', note: '5 attempts, 5 min'},
        {path: path('admin_login'), label: 'Admin Login', note: '3 attempts, 30 min'},
        {path: path('demo_home'), label: 'Home', note: 'Overview'},
    ]}) }}
{% endblock %}
