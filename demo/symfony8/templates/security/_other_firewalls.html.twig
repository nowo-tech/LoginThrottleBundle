{#- "Test other firewalls" section shared by the login pages. Parameter: links (list of {path, label, note}). -#}
{% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Test other firewalls', intro: 'This demo includes 3 different firewalls with independent throttling. Each firewall has its own throttling state.', kind: 'list', links: links} %}
    {% block section_body %}
        <p>
            {% for link in links %}
                <a href="{{ link.path }}" class="nowo-ui-btn nowo-ui-btn--outline">{{ link.label }} <span class="nowo-ui-muted">{{ link.note }}</span></a>
            {% endfor %}
        </p>
    {% endblock %}
{% endembed %}
