{% extends 'base.html.twig' %}

{% block title %}Admin Panel - Login Throttle Demo{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}<a href="{{ path('admin_logout') }}" class="nowo-ui-btn nowo-ui-btn--outline">Logout</a>{% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: title, intro: message, toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Admin firewall configuration', intro: 'This page is protected by the admin firewall with strict throttling.', kind: 'detail', firewall_config: firewall_config} %}
        {% block section_body %}
            <ul>
                <li><strong>Firewall:</strong> {{ firewall_config.name }}</li>
                <li><strong>Max Attempts:</strong> {{ firewall_config.max_attempts }}</li>
                <li><strong>Timeout:</strong> {{ firewall_config.timeout }}</li>
                <li><strong>Storage:</strong> {{ firewall_config.storage }}</li>
            </ul>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Testing multiple firewalls', intro: 'Three firewalls with different throttling configurations.', kind: 'list'} %}
        {% block section_body %}
            <ul>
                <li><strong>Main Firewall</strong> (<a href="{{ path('login') }}">/login</a>): 3 attempts, 10 minutes</li>
                <li><strong>API Firewall</strong> (<a href="{{ path('api_login_page') }}">/api/login-page</a>): 5 attempts, 5 minutes</li>
                <li><strong>Admin Firewall</strong> (current): 3 attempts, 30 minutes</li>
            </ul>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Current user', kind: 'detail'} %}
        {% block section_body %}
            <p><strong>Email:</strong> {{ app.user.userIdentifier }}</p>
            <p><strong>Roles:</strong> {{ app.user.roles|join(', ') }}</p>
        {% endblock %}
    {% endembed %}
{% endblock %}
