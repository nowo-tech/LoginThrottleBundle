{% extends 'base.html.twig' %}

{% block title %}Home - Login Throttle Demo{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: title}) }}
{% endblock %}

{% block body %}
    <section class="nowo-ui-card">
        <div class="nowo-ui-card__body">
            <p>{{ message|raw }}</p>
            <h2 class="nowo-ui-card__title">Features</h2>
            <ul>
                {% for feature in features %}
                    <li>{{ feature|raw }}</li>
                {% endfor %}
            </ul>
        </div>
    </section>

    <section class="nowo-ui-card">
        <div class="nowo-ui-card__body">
            <h2 class="nowo-ui-card__title">Multiple firewalls configuration</h2>
            <p>This demo showcases <strong>3 different firewalls</strong> with independent throttling settings:</p>
            <div class="nowo-ui-cards">
                {% for firewall in firewalls %}
                    <section class="nowo-ui-card">
                        <div class="nowo-ui-card__body">
                            <h3 class="nowo-ui-card__title">{{ firewall.name }} Firewall</h3>
                            <p><strong>Path:</strong> <a href="{{ firewall.path }}">{{ firewall.path }}</a></p>
                            <p><strong>Max Attempts:</strong> <span class="nowo-ui-badge nowo-ui-badge--primary">{{ firewall.max_attempts }}</span></p>
                            <p><strong>Timeout:</strong> <span class="nowo-ui-badge nowo-ui-badge--info">{{ firewall.timeout }}</span></p>
                            <p><strong>Storage:</strong> <span class="nowo-ui-badge nowo-ui-badge--success">{{ firewall.storage }}</span></p>
                            <a href="{{ firewall.path }}" class="nowo-ui-btn nowo-ui-btn--primary">Test {{ firewall.name }} Login</a>
                        </div>
                    </section>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="nowo-ui-card">
        <div class="nowo-ui-card__body">
            <h2 class="nowo-ui-card__title">How to test multiple firewalls</h2>
            <ol>
                <li><strong>Main Firewall</strong> (<a href="{{ path('login') }}">/login</a>): Try 3 wrong attempts, blocked for 10 minutes</li>
                <li><strong>API Firewall</strong> (<a href="{{ path('api_login_page') }}">/api/login-page</a>): Try 5 wrong attempts, blocked for 5 minutes (more lenient)</li>
                <li><strong>Admin Firewall</strong> (<a href="{{ path('admin_login') }}">/admin/login</a>): Try 3 wrong attempts, blocked for 30 minutes (very strict)</li>
            </ol>
            <p><strong>Note:</strong> Each firewall has independent throttling. Being blocked in one firewall doesn't affect the others!</p>
        </div>
    </section>

    <section class="nowo-ui-card">
        <div class="nowo-ui-card__body">
            <h2 class="nowo-ui-card__title">Configuration comparison</h2>
            <table class="nowo-ui-data-table">
                <thead>
                    <tr>
                        <th>Firewall</th>
                        <th>Max Attempts</th>
                        <th>Timeout</th>
                        <th>Storage</th>
                        <th>Use Case</th>
                    </tr>
                </thead>
                <tbody>
                    {% for firewall in firewalls %}
                        <tr>
                            <td><strong>{{ firewall.name }}</strong></td>
                            <td>{{ firewall.max_attempts }}</td>
                            <td>{{ firewall.timeout }}</td>
                            <td>{{ firewall.storage }}</td>
                            <td>
                                {% if firewall.name == 'Main' %}
                                    Standard web login
                                {% elseif firewall.name == 'API' %}
                                    API authentication (more lenient)
                                {% else %}
                                    Admin panel (very strict)
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
