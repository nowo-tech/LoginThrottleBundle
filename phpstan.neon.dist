parameters:
  level: 8
  # Analyse against every supported PHP version (composer.json: >=8.2 <8.6) so results do not depend
  # on the PHP runtime that happens to run PHPStan (REQ-CS-006).
  phpVersion:
    min: 80200
    max: 80599
  paths:
    - src
  excludePaths:
    - demo/*
  ignoreErrors: []

includes:
  - vendor/phpstan/phpstan-symfony/extension.neon
  - vendor/phpstan/phpstan-phpunit/extension.neon
  - vendor/nowo-tech/phpstan-frankenphp/extension.neon
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-classic.neon
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker-strict.neon
