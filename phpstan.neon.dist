parameters:
  level: 8
  # Analyse against every supported PHP version (composer.json: >=8.2 <8.6) so results do not depend
  # on the PHP runtime that happens to run PHPStan (REQ-CS-006).
  phpVersion:
    min: 80200
    max: 80599
  paths:
    - src
  excludePaths:
    - demo/*
  ignoreErrors: []
  # 3.15 (Beacon spec 239): PhpStanFrankenPhp 1.4 worker load-readiness rules. Every attempt write runs as one unit
  # of Transaction\AttemptLockRunner (transaction-doctrine); the bundle never flushes an entity manager.
  frankenphp:
    flagRollbackAfterNestedBegin: true
    flagFlushInHandWrittenTransaction: true
    flagUnboundedRecursion: true
    flagFlushWithoutClosedManagerRecovery: true

includes:
  - vendor/phpstan/phpstan-symfony/extension.neon
  - vendor/phpstan/phpstan-phpunit/extension.neon
  - vendor/nowo-tech/phpstan-frankenphp/extension.neon
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-classic.neon
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker-strict.neon
